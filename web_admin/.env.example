# Copia este archivo a .env.local (no subir a git).
# Reinicia "npm run dev" despues de guardar cambios.

# OPCION A (recomendada en local): ruta al JSON descargado de Firebase
# Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/rutasegura-a74f7-firebase-adminsdk-fbsvc-51973303e3.json

# OPCION B (produccion / hosting): JSON completo en UNA sola linea
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"rutasegura-a74f7",...}

# Solo para scripts: node scripts/create-superuser.js
SUPER_ADMIN_EMAIL=super@tudominio.com
SUPER_ADMIN_PASSWORD=Minimo8chars
SUPER_ADMIN_NAME=Super Admin

# Login propietario — solo para el super admin dueño del sistema.
# Los admins de colegio siguen entrando solo con correo.
# Reinicia "npm run dev" despues de cambiar estas lineas.
NEXT_PUBLIC_OWNER_LOGIN_ID=1725049827
NEXT_PUBLIC_OWNER_LOGIN_EMAIL=csavilaf95@gmail.com

# Estilo vectorial del mapa (opcional). Por defecto: OpenFreeMap Liberty
# NEXT_PUBLIC_MAP_STYLE_STREETS=https://tiles.openfreemap.org/styles/liberty

SCHOOL_ADMIN_EMAIL=admin@tudominio.com
SCHOOL_ADMIN_PASSWORD=Minimo8chars
SCHOOL_ADMIN_NAME=Administrador Colegio
SCHOOL_UNIT_CODE=CAD31
SCHOOL_NAME=Nombre del colegio
